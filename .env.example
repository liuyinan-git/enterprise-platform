# ===== 运行环境 =====
APP_ENV=production
APP_PORT=7550
LOG_LEVEL=INFO

# ===== MySQL =====
MYSQL_DATABASE=enterprise_platform
MYSQL_USER=log_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# MYSQL_HOST=mysql   # 容器内服务名，默认即 mysql

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ===== 采集端认证 =====
# 采集端 API 密钥：建议使用独立密钥登记机制
COLLECTOR_API_KEY=CHANGE_ME_COLLECTOR_KEY

# ===== 日志接入限制 =====
MAX_LOGS_PER_BATCH=1000
MAX_RAW_MESSAGE_CHARS=20000

# ===== 企业微信（自建应用）=====
WECOM_ENABLED=false
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=0
WECOM_TOUSER=

# ===== AI 研判（默认本地模型；亦支持 DeepSeek 等 OpenAI 兼容接口）=====
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
AI_MAX_RETRIES=2
# AI 研判企业微信补发的最低风险等级：normal / suspicious / malicious，留空关闭
AI_WECOM_MIN_RISK=suspicious

# ===== 附件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# ===== 日志保留 =====
RAW_LOG_RETENTION_DAYS=90
EVENT_RETENTION_DAYS=365

# ===== 智能体管控 =====
# 智能体心跳超时判定为离线的宽限秒数
AGENT_OFFLINE_GRACE_SECONDS=300

# ===== 模型管控 =====
# 模型端点健康探测超时秒数
MODEL_CHECK_TIMEOUT_SECONDS=5

# ===== 数据库管控 =====
# 数据库实例连接探测超时秒数
DATABASE_CHECK_TIMEOUT_SECONDS=3

# ===== OIDC 外部认证（默认关闭，接入统一认证平台后开启并填写）=====
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_AUTHORIZE_URL=
OIDC_TOKEN_URL=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5170/auth/callback
OIDC_AUDIENCE=
# token 中角色字段名（如 roles / realm_access.roles / groups）
OIDC_ROLES_CLAIM=roles
OIDC_SCOPES=openid profile
