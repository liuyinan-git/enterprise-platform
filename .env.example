# ===== 运行环境 =====
APP_ENV=production
APP_PORT=7550
LOG_LEVEL=INFO

# ===== MySQL =====
MYSQL_DATABASE=enterprise_platform
MYSQL_USER=log_app
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
# MYSQL_HOST=mysql   # 容器内服务名，默认即 mysql

# ===== Redis =====
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_DB=0

# ===== 采集端认证 =====
# 采集端 API 密钥：建议使用独立密钥登记机制
COLLECTOR_API_KEY=CHANGE_ME_COLLECTOR_KEY

# ===== 日志接入限制 =====
MAX_LOGS_PER_BATCH=1000
MAX_RAW_MESSAGE_CHARS=20000

# ===== 企业微信（自建应用）=====
WECOM_ENABLED=false
WECOM_CORPID=
WECOM_CORPSECRET=
WECOM_AGENTID=0
WECOM_TOUSER=
# 通知最低级别（low/medium/high/critical），低于此级别只记录不推送
WECOM_NOTIFY_MIN_SEVERITY=medium
WECOM_TIMEOUT_SECONDS=5

# ===== AI 研判（默认本地模型；亦支持 DeepSeek 等 OpenAI 兼容接口）=====
AI_ENABLED=false
AI_PROVIDER=ollama
AI_BASE_URL=http://ollama:11434/v1
AI_MODEL=
AI_API_KEY=
AI_TIMEOUT_SECONDS=60
AI_MAX_INPUT_CHARS=12000
AI_MAX_RETRIES=2
# AI 研判企业微信补发的最低风险等级：normal / suspicious / malicious，留空关闭
AI_WECOM_MIN_RISK=suspicious

# ===== 附件上传 =====
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=200

# ===== 日志保留 =====
RAW_LOG_RETENTION_DAYS=7
EVENT_RETENTION_DAYS=7

# ===== 智能体管控 =====
# 智能体心跳超时判定为离线的宽限秒数
AGENT_OFFLINE_GRACE_SECONDS=300

# ===== 模型管控 =====
# 模型端点健康探测超时秒数
MODEL_CHECK_TIMEOUT_SECONDS=5

# ===== 模型监控（用量采集 / 告警 / 容器实况）=====
# vLLM /metrics 计数器指标名（不同版本命名可能不同，可按模型覆盖）
MODEL_USAGE_METRIC=vllm:request_success_total
MODEL_METRICS_TIMEOUT_SECONDS=10
# 模型服务告警：连续失败 N 次触发企业微信；恢复时发恢复通知
MODEL_ALERT_ENABLED=true
MODEL_ALERT_FAILURE_THRESHOLD=3
MODEL_ALERT_RECOVERY_ENABLED=true
# 模型容器实况（只读，经 docker-socket-proxy）
MODEL_CONTAINER_ENABLED=false
MODEL_CONTAINER_PROXY_URL=http://docker-proxy:2375
MODEL_CONTAINER_TIMEOUT_SECONDS=3

# ===== 数据库管控 =====
# 数据库实例连接探测超时秒数
DATABASE_CHECK_TIMEOUT_SECONDS=3

# ===== 容器管控（经 docker-socket-proxy 白名单代理）=====
# 全部容器只读可见；仅「识别出受管类型」且非平台自身的容器可启停。
# 受管类型清单（当前 19 类：关系型 / 缓存 / 搜索 / 向量库 / 知识库）见
# backend/app/modules/database/containers.py 的 MANAGED_TYPES，刻意不在此处重复列举以免过期。
# 启停所需的角色是 database_container_admin（admin 恒可用）。
CONTAINER_PROXY_URL=http://docker-proxy:2375
CONTAINER_REQUEST_TIMEOUT_SECONDS=5
CONTAINER_ACTION_TIMEOUT_SECONDS=8
CONTAINER_STOP_GRACE_SECONDS=5
CONTAINER_LOG_TAIL_DEFAULT=200
CONTAINER_LOG_TAIL_MAX=1000
CONTAINER_LOG_MAX_CHARS=262144
# 该 compose 项目下的容器一律视为「平台自身」，禁止启停
CONTAINER_PROTECTED_PROJECT=enterprise-platform
# ⚠️ 上线前必读：GATEWAY_AUTH_ENABLED=false 时后端返回匿名 admin，
#    内网任何能访问 7550 的人都能启停宿主机的数据库容器，务必先开启网关认证。

# ===== AI Agent 平台（容器 / 接口监控）=====
# 与上面的「容器管控」是**两套独立配置**：那套只放行 19 类受管数据库类型，
# 这套按「容器属于哪个项目」放行，启停面宽得多，所以默认值也更保守。
# 读接口全部只读可见；只有「已分类到唯一项目」且非平台自身的容器可启停，
# 未分类与规则冲突的一律只读。启停所需的角色是 agent_container_admin（admin 恒可用）。
# 分类规则、自保护、日志解帧等实现见 backend/app/modules/agent/ 下的
# containers.py / docker_client.py / probes.py，此处刻意不重复列举规则细节以免过期。
AGENT_DOCKER_PROXY_URL=http://docker-proxy:2375
AGENT_DOCKER_REQUEST_TIMEOUT_SECONDS=5
AGENT_DOCKER_ACTION_TIMEOUT_SECONDS=8
AGENT_DOCKER_STOP_GRACE_SECONDS=5
AGENT_LOG_TAIL_DEFAULT=200
AGENT_LOG_TAIL_MAX=1000
AGENT_LOG_MAX_CHARS=262144
# 让 Docker 返回时间戳（RFC3339 UTC），服务端逐行转成 naive 北京时后再返回
AGENT_LOG_TIMESTAMPS=true
# 该 compose 项目下的容器一律视为「平台自身」，禁止启停
AGENT_PROTECTED_PROJECT=enterprise-platform
AGENT_PROBE_DEFAULT_TIMEOUT_SECONDS=5
AGENT_PROBE_MAX_TIMEOUT_SECONDS=60
# 内网自签证书的接口才关；关闭后只影响探测请求，不改全局 SSL 默认值
AGENT_PROBE_VERIFY_TLS=true
AGENT_PROBE_MAX_EXCERPT_CHARS=500
# 监控历史保留天数，由 cleanup_agent_history 周期任务执行（配了就必须有清理任务）
AGENT_HISTORY_RETENTION_DAYS=30

# ===== 网关统一认证（APISIX openid-connect + forward-auth，默认关闭）=====
# 开启后后端从 APISIX 注入的用户头读取用户与角色
GATEWAY_AUTH_ENABLED=false
GATEWAY_USER_ID_HEADER=x-user-id
GATEWAY_USERNAME_HEADER=x-user-num
GATEWAY_ROLES_HEADER=x-user-roles
